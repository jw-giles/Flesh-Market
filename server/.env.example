PORT=7777
TRADE_TAX_BPS=25

# Patreon webhook secret — get this from your Patreon webhook dashboard
# Leave blank during dev (skips signature verification)
PATREON_WEBHOOK_SECRET=

# Patreon API, required for the monthly membership audit (1.3.7.3).
# Without BOTH of these the audit reports 'not configured' and changes nothing.
# Create a creator access token at https://www.patreon.com/portal/registration/register-clients
# The token needs the campaigns.members and campaigns.members[email] scopes.
# PATREON_CAMPAIGN_ID is the numeric id of your campaign.
PATREON_ACCESS_TOKEN=
PATREON_CAMPAIGN_ID=
# Refuse to commit an audit that would revoke more than this share of non-exempt
# tiers. Guards against a bad campaign id reading as 'nobody is subscribed'.
PATREON_AUDIT_MAX_REVOKE_FRAC=0.5

# Optional: custom DB path
# DB_PATH=./fleshmarket.db

# Comma-separated dev account names — MrFlesh MUST be first (prime/owner account)
# Run node seed_devaccounts.mjs after adding names to create hashed credentials
DEV_ACCOUNTS=MrFlesh,DEV-FIXER,DEV-SLUT,DEV-SMASHER,DEV-GURU,DEV-PEAK
